# PromptLab environment template
# Copy this file to .env and fill in secure values before running the app.
# Never commit real secrets to the repository.

# Gemini provider keys used by separate model roles.
# Each Gemini role must have its own credential. The legacy shared key is not used.
GEMINI_OPTIMIZER_API_KEY=
GEMINI_PERFORMER_API_KEY=
GROQ_API_KEY=

# Server port
PORT=8000

# Configurable model names
# Examples: gemini-2.0-flash, llama-3.3-70b-versatile
GEMINI_OPTIMIZER_MODEL=gemini-2.0-flash
GEMINI_PERFORMER_MODEL=gemini-2.0-flash
JUDGE_MODEL=llama-3.3-70b-versatile

# Optimization defaults
DEFAULT_ACTIVE_CANDIDATES=4
DEFAULT_EDITED_CANDIDATES=2
DEFAULT_MAX_ITERATIONS=3
DEFAULT_FINAL_TOP_N=3
DEFAULT_UCB_C=1.414
DEFAULT_STAGNATION_LIMIT=2
DEFAULT_MIN_IMPROVEMENT=0.01
# Maximum provider calls allowed for one optimization session
DEFAULT_MAX_LLM_CALLS=30

# Allow mock LLM responses for offline testing only when explicitly enabled.
# This should remain false in production.
ALLOW_MOCK_LLMS=false

# Prompt validation settings
MIN_PROMPT_CHARS=5
MAX_PROMPT_CHARS=12000
